+def disable_flash_attention(cfg: omegaconf.DictConfig) -> None:
+    """Force the ptv3vanilla backbone onto its fp32 attention path.
+
+    The released checkpoints ship ``enable_flash: true``, which casts q/k/v to
+    fp16 before ``scaled_dot_product_attention``. That is a CUDA-oriented path;
+    on CPU it is unsupported or drastically slower. The ``else`` branch is the
+    mathematically equivalent fp32 matmul+softmax (with ``upcast_attention`` and
+    ``upcast_softmax`` on), and the weights are dtype-agnostic — so this is a
+    pure config change with no effect on the state dict.
+    """
+    for side in ("diffusion", "discriminator"):
+        block = cfg.get(side)
+        if block is not None and block.get("ptv3vanilla") is not None:
+            block.ptv3vanilla.enable_flash = False
+
+
