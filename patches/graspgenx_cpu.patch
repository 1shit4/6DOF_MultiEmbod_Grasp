+def resolve_device() -> torch.device:
+    """Device for model weights and request tensors.
+
+    ``GRASPGENX_DEVICE`` overrides autodetection so the model can be pinned to
+    CPU on a machine with no GPU (or forced to CPU for parity debugging).
+    """
+    override = os.environ.get("GRASPGENX_DEVICE")
+    if override:
+        return torch.device(override)
+    return torch.device("cuda" if torch.cuda.is_available() else "cpu")
+
+
+def sampler_device(sampler) -> torch.device:
+    """Device a sampler's weights actually live on."""
+    return next(sampler.model.parameters()).device
+
